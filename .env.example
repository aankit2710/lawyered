# Backend - NestJS
BACKEND_PORT=3001
NODE_ENV=development

# Database - PostgreSQL (use localhost when running seed/tests on host machine)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lawyered
DB_USER=postgres
DB_PASSWORD=postgres_dev_password
DATABASE_URL=postgresql://postgres:postgres_dev_password@postgres:5432/lawyered

# Frontend - Next.js
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRATION=24h

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Application
APP_NAME=Lawyered Will Maker
APP_VERSION=0.1.0

# Production / security (Phase 10)
TYPEORM_SYNCHRONIZE=false
RUN_MIGRATIONS=true
RUN_SEED=false
DB_POOL_MAX=20
CORS_ORIGINS=http://localhost:3000
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
TRUST_PROXY=false
OPENAI_MAX_RETRIES=3
OPENAI_CIRCUIT_FAILURE_THRESHOLD=5
OPENAI_CIRCUIT_COOLDOWN_MS=60000

# Demo account (Phase 9) — run: npm run db:seed
DEMO_USER_EMAIL=demo@lawyered.com
DEMO_USER_PASSWORD=Demo@Lawyered1

# PDF generation (Phase 8) — optional custom Chromium path in Docker
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
