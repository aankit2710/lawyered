# Backend - NestJS
BACKEND_PORT=3001
NODE_ENV=development

# Database - PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_NAME=lawyered
DB_USER=postgres
DB_PASSWORD=postgres_dev_password
DATABASE_URL=postgresql://postgres:postgres_dev_password@postgres:5432/lawyered

# Frontend - Next.js
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRATION=24h

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Application
APP_NAME=Lawyered Will Maker
APP_VERSION=0.1.0
