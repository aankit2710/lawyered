# Backend Dockerfile for NestJS

FROM node:18-alpine@sha256:8d6421d663b4c28fd3ebc498332f249011d118945588d0a35cb9bc4b8ca09d9e AS builder

WORKDIR /app

# Install dependencies from the backend app lockfile for reproducible builds.
COPY apps/backend/package.json apps/backend/package-lock.json ./
RUN npm ci

# Copy backend sources and build the app.
COPY apps/backend ./
RUN npm run build

FROM node:18-alpine@sha256:8d6421d663b4c28fd3ebc498332f249011d118945588d0a35cb9bc4b8ca09d9e AS runner

WORKDIR /app
ENV NODE_ENV=production

COPY apps/backend/package.json apps/backend/package-lock.json ./
RUN npm ci --omit=dev

COPY --from=builder /app/dist ./dist

EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD node -e "require('http').get('http://localhost:3001/api/health', (r) => {if (r.statusCode !== 200) throw new Error(r.statusCode)})"

CMD ["node", "dist/main"]
