# Frontend Dockerfile for Next.js

FROM node:18-alpine@sha256:8d6421d663b4c28fd3ebc498332f249011d118945588d0a35cb9bc4b8ca09d9e AS builder

WORKDIR /app

# Install dependencies from the frontend app lockfile for reproducible builds.
COPY apps/frontend/package.json apps/frontend/package-lock.json ./
RUN npm ci

# Copy frontend sources and build the app.
COPY apps/frontend ./
RUN npm run build

FROM node:18-alpine@sha256:8d6421d663b4c28fd3ebc498332f249011d118945588d0a35cb9bc4b8ca09d9e AS runner

WORKDIR /app
ENV NODE_ENV=production

COPY apps/frontend/package.json apps/frontend/package-lock.json ./
RUN npm ci --omit=dev

COPY --from=builder /app/.next ./.next
COPY --from=builder /app/public ./public
COPY --from=builder /app/next.config.js ./next.config.js

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost:3000 || exit 1

CMD ["npm", "start"]
